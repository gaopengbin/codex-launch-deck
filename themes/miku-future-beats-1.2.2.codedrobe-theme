    "traework": {
      "css": "/* Miku Future Beats · TRAE SOLO (solo-lite shell)\r\n   Deep adaptation: override the shell's --vscode-* design tokens (the app\r\n   defines them on plain `body` selectors inside style tags, so the host-class\r\n   scope below always outranks them), then layer texture, hero, and ♫\r\n   decorations on stable solo-lite surfaces. */\r\n\r\nhtml.codedrobe-host-traework body {\r\n  color-scheme: light;\r\n\r\n  --miku-tw-ink: #163f4b;\r\n  --miku-tw-muted: #557480;\r\n  --miku-tw-teal: #16bfc4;\r\n  --miku-tw-deep-teal: #087b86;\r\n  --miku-tw-pink: #ff8fc8;\r\n  --miku-tw-lavender: #9f92f8;\r\n  --miku-tw-line: rgba(22, 191, 196, .24);\r\n  --miku-tw-shadow: rgba(12, 105, 119, .12);\r\n\r\n  /* Ink */\r\n  --vscode-foreground: #163f4b;\r\n  --vscode-icube-colorDefaultText: #163f4b;\r\n  --vscode-icube--text-text-default: #163f4b;\r\n  --vscode-icube-colorHighlightText: #0e2f38;\r\n  --vscode-descriptionForeground: #557480;\r\n  --vscode-icube-colorGrayText: #557480;\r\n  --vscode-icube-colorDisableText: #8aa6ad;\r\n\r\n  /* Brand and links */\r\n  --vscode-textLink-foreground: #0e9ba1;\r\n  --vscode-textLink-activeForeground: #12a9ae;\r\n  --vscode-button-background: #16bfc4;\r\n  --vscode-button-foreground: #ffffff;\r\n  --vscode-icube-colorBrand: #0e9ba1;\r\n  --vscode-focusBorder: rgba(22, 191, 196, .6);\r\n\r\n  /* Lines */\r\n  --vscode-icube-colorLine1: rgba(22, 191, 196, .14);\r\n  --vscode-icube-colorLine2: rgba(22, 191, 196, .28);\r\n  --vscode-icube--border-border-neutral-l1: rgba(22, 191, 196, .14);\r\n  --vscode-chat-requestBorder: rgba(22, 191, 196, .25);\r\n\r\n  /* Fills and hovers */\r\n  --vscode-toolbar-hoverBackground: rgba(22, 191, 196, .12);\r\n  --vscode-icube-colorBtnHover: rgba(22, 191, 196, .12);\r\n  --vscode-icube-colorBtnHover2: rgba(22, 191, 196, .18);\r\n  --vscode-list-hoverBackground: rgba(22, 191, 196, .12);\r\n  --vscode-icube--bg-bg-overlay-l2: rgba(22, 191, 196, .12);\r\n  --vscode-icube--bg-bg-overlay-l3: rgba(22, 191, 196, .18);\r\n  --vscode-input-background: rgba(22, 191, 196, .07);\r\n\r\n  /* Surfaces */\r\n  --vscode-editor-background: #fbfeff;\r\n  --vscode-icube-colorBg1: #fbfeff;\r\n  --vscode-icube-colorBg2: #e6f6f9;\r\n  --vscode-icube-colorBg3: #fbfeff;\r\n  --vscode-editorWidget-background: #f0fafc;\r\n  --vscode-widget-shadow: rgba(12, 105, 119, .15);\r\n  --vscode-badge-background: #a5e3e6;\r\n}\r\n\r\n/* ---- application shell and background ---------------------------------- */\r\n\r\nhtml.codedrobe-host-traework body.solo-lite {\r\n  background:\r\n    linear-gradient(135deg, rgba(247, 253, 255, .80), rgba(230, 248, 251, .86) 48%, rgba(249, 239, 255, .84)),\r\n    var(--codedrobe-image-texture) center / 560px auto repeat !important;\r\n  color: var(--miku-tw-ink) !important;\r\n}\r\n\r\n/* ---- sidebar ------------------------------------------------------------ */\r\n\r\nhtml.codedrobe-host-traework .task-list-base {\r\n  background:\r\n    linear-gradient(180deg,\r\n      rgba(247, 253, 255, .55) 0%,\r\n      rgba(218, 247, 250, .42) 56%,\r\n      rgba(246, 236, 255, .30) 82%,\r\n      rgba(255, 236, 247, .18) 100%),\r\n    var(--codedrobe-image-hero) left calc(100% + 40px) / 130% auto no-repeat,\r\n    var(--codedrobe-image-texture) center / 460px auto repeat !important;\r\n  box-shadow: inset -1px 0 var(--miku-tw-line) !important;\r\n}\r\n\r\nhtml.codedrobe-host-traework .task-list-heading {\r\n  color: var(--miku-tw-deep-teal) !important;\r\n  letter-spacing: .04em;\r\n}\r\n\r\n/* ---- workspace cards (home .panel-content + conversation chat panel) ---- */\r\n\r\nhtml.codedrobe-host-traework .solo-lite-panel-border {\r\n  border: 1px solid var(--miku-tw-line) !important;\r\n}\r\n\r\nhtml.codedrobe-host-traework .panel-content,\r\nhtml.codedrobe-host-traework .solo-lite-chat-panel-container {\r\n  background:\r\n    linear-gradient(160deg, rgba(251, 254, 255, .96), rgba(236, 250, 252, .94) 55%, rgba(248, 242, 255, .93)),\r\n    var(--codedrobe-image-texture) center / 760px auto repeat !important;\r\n  box-shadow: 0 10px 30px var(--miku-tw-shadow), inset 0 0 0 1px rgba(255, 255, 255, .65) !important;\r\n}\r\n\r\n/* ---- home hero ---------------------------------------------------------- */\r\n\r\n/* Full-height Miku artwork on the right of the home card, fading under the\r\n   centered welcome copy — the same treatment as the QoderWork home canvas. */\r\nhtml.codedrobe-host-traework .panel-content:has(.initial-chat-panel) {\r\n  background-color: #f7fdff !important;\r\n  background-image:\r\n    linear-gradient(90deg,\r\n      rgba(247, 253, 255, .97) 0%,\r\n      rgba(240, 251, 253, .95) 44%,\r\n      rgba(240, 251, 253, .80) 62%,\r\n      rgba(243, 240, 255, .38) 82%,\r\n      rgba(255, 236, 247, .12) 100%),\r\n    var(--codedrobe-image-hero),\r\n    var(--codedrobe-image-texture) !important;\r\n  background-repeat: no-repeat, no-repeat, repeat !important;\r\n  background-size: 100% 100%, auto 112%, 560px auto !important;\r\n  background-position: center, right -36px center, center !important;\r\n}\r\n\r\nhtml.codedrobe-host-traework .initial-chat-panel {\r\n  position: relative !important;\r\n}\r\n\r\nhtml.codedrobe-host-traework .initial-chat-panel::after {\r\n  content: \"Miku Future Beats ♫ TRAE SOLO\";\r\n  position: absolute;\r\n  right: 22px;\r\n  bottom: 16px;\r\n  z-index: 2;\r\n  color: var(--miku-tw-deep-teal);\r\n  font: italic 650 13px/1.2 \"Avenir Next\", \"PingFang SC\", sans-serif;\r\n  letter-spacing: .04em;\r\n  text-shadow: 0 1px white, 0 0 12px rgba(255, 255, 255, .85);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Keep the animated per-mode title, add the Miku tagline underneath. */\r\nhtml.codedrobe-host-traework .welcomeTitleWrapper::after {\r\n  content: \"和初音未来一起，让灵感、代码与旋律同频闪耀 ♫\";\r\n  display: block;\r\n  margin-top: 10px;\r\n  text-align: center;\r\n  color: var(--miku-tw-muted);\r\n  font: 500 14px/1.6 \"Avenir Next\", \"PingFang SC\", sans-serif;\r\n  letter-spacing: .03em;\r\n}\r\n\r\n/* 