      "css": "/* Miku Future Beats · QoderWork CN\r\n   Deep adaptation: override the app's --color-* design tokens (teal cyber-pop),\r\n   then layer texture, hero, and ♫ decorations on stable semantic surfaces.\r\n   html:root.codedrobe-host-qoderwork (0,2,1) outranks the app's\r\n   :root[data-theme=...] (0,2,0) token blocks in every appearance mode. */\r\n\r\nhtml:root.codedrobe-host-qoderwork {\r\n  color-scheme: light !important;\r\n\r\n  --miku-qw-ink: #163f4b;\r\n  --miku-qw-muted: #557480;\r\n  --miku-qw-teal: #16bfc4;\r\n  --miku-qw-deep-teal: #087b86;\r\n  --miku-qw-cyan: #74dce4;\r\n  --miku-qw-pink: #ff8fc8;\r\n  --miku-qw-lavender: #9f92f8;\r\n  --miku-qw-ice: #eefbff;\r\n  --miku-qw-line: rgba(22, 191, 196, .24);\r\n  --miku-qw-shadow: rgba(12, 105, 119, .12);\r\n\r\n  /* Primary: native mint green -> Miku teal */\r\n  --color-primary-bg: #eafbfc;\r\n  --color-primary-bg-hover: #d9f6f8;\r\n  --color-primary-border: #aeeaed;\r\n  --color-primary-border-hover: #85e0e5;\r\n  --color-primary-hover: #12a9ae;\r\n  --color-primary: #16bfc4;\r\n  --color-primary-active: #0e9ba1;\r\n  --color-primary-text-hover: #0e9ba1;\r\n  --color-primary-text: #163f4b;\r\n  --color-primary-text-active: #0e9ba1;\r\n  --color-text-on-primary: #ffffff;\r\n\r\n  /* Ink */\r\n  --color-text: #163f4b;\r\n  --color-text-base: #10333d;\r\n  --color-text-secondary: #3f6470;\r\n  --color-text-tertiary: #557480;\r\n  --color-text-quaternary: #7f9aa3;\r\n\r\n  /* Lines and fills: iced teal */\r\n  --color-border: #9fd6dc;\r\n  --color-border-secondary: #c2e7eb;\r\n  --color-border-tertiary: #d8f0f3;\r\n  --color-fill: #cfeef1;\r\n  --color-fill-secondary: #ddf4f6;\r\n  --color-fill-tertiary: #eefafb;\r\n  --color-fill-quaternary: #f7fdfd;\r\n  --color-fill-disable: #d5e5e8;\r\n\r\n  /* Surfaces */\r\n  --color-bg-container: #ffffff;\r\n  --color-bg-elevated: #f3fbfc;\r\n  --color-bg-layout: #ecf9fc;\r\n  --color-bg-spotlight: #f3fbfc;\r\n  --color-bg-base: #fbfeff;\r\n  --color-link: #0e9ba1;\r\n}\r\n\r\n/* ---- application shell and background ---------------------------------- */\r\n\r\nhtml.codedrobe-host-qoderwork .agents-layout-root {\r\n  background:\r\n    linear-gradient(135deg, rgba(247, 253, 255, .78), rgba(230, 248, 251, .84) 48%, rgba(249, 239, 255, .82)),\r\n    var(--codedrobe-image-texture) center / 560px auto repeat !important;\r\n  color: var(--miku-qw-ink) !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .agents-layout-root::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  pointer-events: none;\r\n  background:\r\n    radial-gradient(circle at 85% 8%, rgba(255, 255, 255, .98) 0 2px, transparent 3px),\r\n    radial-gradient(circle at 15% 19%, rgba(22, 191, 196, .42) 0 1px, transparent 2px),\r\n    linear-gradient(118deg, transparent 0 47%, rgba(159, 146, 248, .08) 49%, transparent 52%);\r\n  background-size: 79px 79px, 67px 67px, 100% 100%;\r\n  opacity: .6;\r\n}\r\n\r\n/* ---- sidebar ------------------------------------------------------------ */\r\n\r\nhtml.codedrobe-host-qoderwork .agents-sidebar {\r\n  background:\r\n    linear-gradient(180deg, rgba(247, 253, 255, .82), rgba(218, 247, 250, .72) 62%, rgba(246, 236, 255, .70)),\r\n    var(--codedrobe-image-texture) center / 460px auto repeat !important;\r\n  box-shadow: inset -1px 0 var(--miku-qw-line);\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .agents-sidebar .sidebar-section-title {\r\n  color: var(--miku-qw-deep-teal) !important;\r\n  letter-spacing: .05em;\r\n}\r\n\r\n/* ---- workspace card ----------------------------------------------------- */\r\n\r\nhtml.codedrobe-host-qoderwork .agents-content-area {\r\n  background: transparent !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .agents-parchment-paper-surface {\r\n  background:\r\n    linear-gradient(160deg, rgba(251, 254, 255, .95), rgba(236, 250, 252, .93) 55%, rgba(248, 242, 255, .92)),\r\n    var(--codedrobe-image-texture) center / 760px auto repeat !important;\r\n  border-color: var(--miku-qw-line) !important;\r\n  box-shadow: 0 10px 30px var(--miku-qw-shadow), inset 0 0 0 1px rgba(255, 255, 255, .65) !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork :is(.chat-header, .chat-panel-header) {\r\n  background: linear-gradient(90deg, rgba(249, 254, 255, .60), rgba(214, 247, 250, .45), rgba(240, 226, 255, .40)) !important;\r\n  box-shadow: inset 0 -1px rgba(22, 191, 196, .16);\r\n}\r\n\r\n/* Aux dock panel (task monitor) gets a soft Miku watermark at its foot. */\r\nhtml.codedrobe-host-qoderwork .agents-chat-panel.workbench-aux-card {\r\n  background-color: #f7fdff !important;\r\n  background-image:\r\n    linear-gradient(180deg,\r\n      rgba(247, 253, 255, .97) 0%,\r\n      rgba(240, 251, 253, .95) 52%,\r\n      rgba(240, 251, 253, .82) 74%,\r\n      rgba(243, 240, 255, .48) 100%),\r\n    var(--codedrobe-image-hero),\r\n    var(--codedrobe-image-texture) !important;\r\n  background-repeat: no-repeat, no-repeat, repeat !important;\r\n  background-size: 100% 100%, auto 52%, 560px auto !important;\r\n  background-position: center, right bottom, center !important;\r\n}\r\n\r\n/* Conversation panels carry the Future Beats signature pill. */\r\nhtml.codedrobe-host-qoderwork .agents-chat-panel > .chat-panel-header {\r\n  position: relative !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .agents-chat-panel:not(.workbench-aux-card) > .chat-panel-header::after {\r\n  content: \"♫ Miku Future Beats · 灵感同频中\";\r\n  position: absolute;\r\n  right: 118px;\r\n  top: 50%;\r\n  z-index: 3;\r\n  height: 24px;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  padding: 0 12px;\r\n  border: 1px solid rgba(22, 191, 196, .28);\r\n  border-radius: 999px;\r\n  background: linear-gradient(135deg, rgba(249, 254, 255, .96), rgba(212, 247, 250, .93), rgba(249, 226, 243, .91));\r\n  color: var(--miku-qw-deep-teal);\r\n  font: 700 11px/1 \"Avenir Next\", \"PingFang SC\", sans-serif;\r\n  letter-spacing: .04em;\r\n  white-space: nowrap;\r\n  text-shadow: 0 1px white;\r\n  box-shadow: 0 4px 12px rgba(12, 105, 119, .12), inset 0 0 0 2px rgba(255, 255, 255, .46);\r\n  transform: translateY(-50%);\r\n  pointer-events: none;\r\n}\r\n\r\n/* ---- home hero ---------------------------------------------------------- */\r\n\r\n/* Full-height Miku artwork on the right of the home canvas, fading under the\r\n   centered welcome copy exactly like the WorkBuddy home header treatment. */\r\nhtml.codedrobe-host-qoderwork .agents-chat-view-root:has(.welcome-title) .agents-parchment-paper-surface {\r\n  background-color: #f7fdff !important;\r\n  background-image:\r\n    linear-gradient(90deg,\r\n      rgba(247, 253, 255, .97) 0%,\r\n      rgba(240, 251, 253, .95) 44%,\r\n      rgba(240, 251, 253, .78) 62%,\r\n      rgba(243, 240, 255, .34) 82%,\r\n      rgba(255, 236, 247, .10) 100%),\r\n    var(--codedrobe-image-hero),\r\n    var(--codedrobe-image-texture) !important;\r\n  background-repeat: no-repeat, no-repeat, repeat !important;\r\n  background-size: 100% 100%, auto 112%, 560px auto !important;\r\n  background-position: center, right -36px center, center !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .agents-chat-view-root:has(.welcome-title)::after {\r\n  content: \"Miku Future Beats ♫ QoderWork\";\r\n  position: absolute;\r\n  right: 22px;\r\n  bottom: 18px;\r\n  z-index: 2;\r\n  color: var(--miku-qw-deep-teal);\r\n  font: italic 650 13px/1.2 \"Avenir Next\", \"PingFang SC\", sans-serif;\r\n  letter-spacing: .04em;\r\n  text-shadow: 0 1px white, 0 0 12px rgba(255, 255, 255, .85);\r\n  pointer-events: none;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .welcome-title {\r\n  font-size: 0 !important;\r\n  line-height: 1 !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .welcome-title::before {\r\n  content: \"初音未来 × QoderWork\";\r\n  display: block;\r\n  background: linear-gradient(100deg, #0e9ba1, #16bfc4 42%, #9f92f8 78%, #ff8fc8);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  font: 750 30px/1.25 \"Avenir Next\", \"PingFang SC\", sans-serif;\r\n  letter-spacing: .02em;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .welcome-title + p {\r\n  font-size: 0 !important;\r\n  line-height: 1 !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .welcome-title + p::before {\r\n  content: \"和初音未来一起，让灵感、代码与旋律同频闪耀 ♫\";\r\n  display: block;\r\n  color: var(--miku-qw-muted);\r\n  font: 500 14px/1.6 \"Avenir Next\", \"PingFang SC\", sans-serif;\r\n  letter-spacing: .03em;\r\n}\r\n\r\n/* ---- composer ----------------------------------------------------------- */\r\n\r\nhtml.codedrobe-host-qoderwork div.bg-bg-base.squircle-xl:has(.chat-input-editor-text) {\r\n  border-color: rgba(22, 191, 196, .38) !important;\r\n  background:\r\n    linear-gradient(145deg, rgba(251, 254, 255, .97), rgba(214, 247, 250, .90) 65%, rgba(248, 226, 243, .88)),\r\n    var(--codedrobe-image-texture) center / 580px auto !important;\r\n  box-shadow: 0 10px 26px rgba(12, 105, 119, .14), inset 0 0 0 3px rgba(255, 255, 255, .56) !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork div.bg-bg-base.squircle-xl:has(.chat-input-editor-text)::before {\r\n  content: \"♫\";\r\n  position: absolute;\r\n  left: -12px;\r\n  top: -13px;\r\n  z-index: 20;\r\n  width: 27px;\r\n  height: 27px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 50%;\r\n  font-size: 14px;\r\n  color: white;\r\n  background: linear-gradient(145deg, #ff9dcc, #16bfc4 62%, #9f92f8);\r\n  box-shadow: 0 4px 12px rgba(12, 105, 119, .19), 0 0 0 3px rgba(255, 255, 255, .74);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Tilted Miku polaroid peeking over the composer's top-right corner. */\r\nhtml.codedrobe-host-qoderwork div.bg-bg-base.squircle-xl:has(.chat-input-editor-text)::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  right: 14px;\r\n  top: -74px;\r\n  z-index: 20;\r\n  width: 74px;\r\n  height: 92px;\r\n  border: 6px solid rgba(252, 254, 255, .98);\r\n  border-bottom-width: 16px;\r\n  border-radius: 3px;\r\n  background-image: var(--codedrobe-image-hero);\r\n  background-repeat: no-repeat;\r\n  background-size: 290% auto;\r\n  background-position: 80% 18%;\r\n  box-shadow: 0 9px 22px rgba(12, 105, 119, .20), 0 0 0 1px rgba(22, 191, 196, .22);\r\n  transform: rotate(5deg);\r\n  pointer-events: none;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .chat-input-editor-text[contenteditable='true'] {\r\n  color: var(--miku-qw-ink) !important;\r\n  caret-color: var(--miku-qw-teal) !important;\r\n}\r\n\r\n/* Send button: native near-black gradient -> Miku beam */\r\nhtml.codedrobe-host-qoderwork .SendButton-send {\r\n  border-color: rgba(12, 105, 119, .38) !important;\r\n  background: linear-gradient(160deg, #ff9dcc, #16bfc4 55%, #9f92f8) !important;\r\n  box-shadow: 0 4px 12px rgba(12, 105, 119, .28), inset 0 1px rgba(255, 255, 255, .40) !important;\r\n}\r\n\r\n/* ---- conversation content ----------------------------------------------- */\r\n\r\nhtml.codedrobe-host-qoderwork .group\\/message :is(pre, code) {\r\n  border-color: rgba(22, 191, 196, .18) !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .group\\/message :is(table, th, td) {\r\n  border-color: rgba(22, 191, 196, .20) !important;\r\n}\r\n\r\nhtml.codedrobe-host-qoderwork .group\\/message th {\r\n  background: linear-gradient(90deg, rgba(199, 242, 246, .64), rgba(244, 224, 242, .58)) !important;\r\n  color: #2e606a !important;\r\n}\r\n\r\n/* ---- focus, responsive, reduced motion ---------------------------------- */\r\n\r\nhtml.codedrobe-host-qoderwork *:focus-visible {\r\n  outline-color: rgba(22, 191, 196, .78) !important;\r\n}\r\n\r\n@media (max-width: 760px) {\r\n  html.codedrobe-host-qoderwork .agents-chat-view-root:has(.welcome-title)::after,\r\n  html.codedrobe-host-qoderwork div.bg-bg-base.squircle-xl:has(.chat-input-editor-text)::after {\r\n    display: none;\r\n  }\r\n\r\n  html.codedrobe-host-qoderwork .agents-chat-view-root:has(.welcome-title) .agents-parchment-paper-surface {\r\n    background-image:\r\n      linear-gradient(90deg, rgba(247, 253, 255, .97), rgba(240, 251, 253, .95)),\r\n      none,\r\n      var(--codedrobe-image-texture) !important;\r\n  }\r\n}\r\n\r\n@media (max-width: 1180px) {\r\n  html.codedrobe-host-qoderwork .agents-chat-panel:not(.workbench-aux-card) > .chat-panel-header::after {\r\n    display: none;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  html.codedrobe-host-qoderwork .agents-layout-root::before {\r\n    opacity: .3;\r\n  }\r\n}\r\n",
      "verification": {
