{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex Proxy Launch Deck",
  "version": "2.3.2",
  "identifier": "dev.geod.codex-launch-deck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1435",
    "beforeDevCommand": "npm run dev -- --port 1435 --strictPort",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../build-package-launcher.ps1 && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codex 代理启动台",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../../compat/PackagedChatGPTLauncher.exe": "bin/PackagedChatGPTLauncher.exe",
      "../../themes/miku-future-beats-1.2.3.codedrobe-theme": "themes/miku-future-beats-1.2.3.codedrobe-theme",
      "../../themes/kuuga-crimson-awakening-1.2.1.codedrobe-theme": "themes/kuuga-crimson-awakening-1.2.1.codedrobe-theme",
      "../../themes/tiga-starlight-awakening-1.1.3.codedrobe-theme": "themes/tiga-starlight-awakening-1.1.3.codedrobe-theme",
      "../../themes/yujie-berry-nocturne-1.0.0.codedrobe-theme": "themes/yujie-berry-nocturne-1.0.0.codedrobe-theme",
      "../../compat/codedrobe-core-0.7.0-beta.0-launchdeck.9.tgz": "compat/codedrobe-core-0.7.0-beta.0-launchdeck.9.tgz"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzQkEzOTNFQ0EyRTFEMzUKUldRMUhTN0tQam02d3lBNDNlOWMzWEpadG1WcEdmYWUzVHFRWExZRmxlVUI4bXgxQWpQamxscVAK",
      "endpoints": [
        "https://github.com/gaopengbin/codex-launch-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
