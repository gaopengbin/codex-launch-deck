{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex Proxy Launch Deck",
  "version": "2.0.0",
  "identifier": "dev.geod.codex-launch-deck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1435",
    "beforeDevCommand": "npm run dev -- --port 1435 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Proxy Launch Deck",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../../themes/miku-future-beats-1.2.1.codedrobe-theme": "themes/miku-future-beats-1.2.1.codedrobe-theme"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
